# ════════════════════════════════════════════════════════
# IT Monitor Bot — ตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงก่อนรัน
# สร้างได้ผ่าน Setup UI ที่ http://localhost:3000/setup
# ════════════════════════════════════════════════════════

# ── LINE Messaging API ────────────────────────────────────
# หาได้จาก LINE Developers Console > channel > Basic settings
LINE_CHANNEL_SECRET=your_line_channel_secret_here
# หาได้จาก LINE Developers Console > channel > Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ── Zabbix ────────────────────────────────────────────────
# URL ของ Zabbix API เช่น http://192.168.1.10/api_jsonrpc.php
ZABBIX_URL=https://your-zabbix-server.com/api_jsonrpc.php
# API Token: Zabbix > Administration > API tokens
ZABBIX_API_TOKEN=your_zabbix_api_token_here

# ── TP-Link Omada Controller (Open API) ───────────────────
# URL ของ Omada Controller เช่น https://192.168.1.20:8043
OMADA_URL=https://your-omada-controller:8043
# Omadac ID: GET /api/info หรือดูใน Controller settings
OMADA_OMADAC_ID=your_omadac_id_here
# Site ID: ดูได้จาก URL ของ Omada หลัง /site/
OMADA_SITE_ID=your_omada_site_id_here
# Open API Client credentials: Omada > Settings > Platform Integration > Open API
OMADA_CLIENT_ID=your_omada_client_id_here
OMADA_CLIENT_SECRET=your_omada_client_secret_here
# Path ของ CA cert สำหรับ self-signed TLS (เว้นว่างถ้าใช้ cert จริง)
# Docker: ใส่ path ภายใน container เช่น /certs/omada-ca.crt
OMADA_CA_CERT_PATH=
# ตั้ง true เมื่อ cert ใช้ CN แทน SAN (ยัง verify chain — ใช้คู่กับ CA_PATH เท่านั้น)
#OMADA_TLS_SKIP_HOSTNAME=true
# Legacy web login (ไม่ใช้กับ Open API แล้ว — คงไว้เผื่อ rollback)
OMADA_USERNAME=your_omada_username_here
OMADA_PASSWORD=your_omada_password_here

# ── HikCentral (OpenAPI / artemis — AK/SK) ────────────────
# URL ของ HikCentral OpenAPI gateway เช่น https://192.168.1.30 (port 443)
HIKCENTRAL_URL=https://your-hikcentral-server
# AppKey/AppSecret: HikCentral > System > Open API > Partner (ต้อง approve + ผูก userId)
HIKCENTRAL_APP_KEY=your_hikcentral_app_key_here
HIKCENTRAL_APP_SECRET=your_hikcentral_app_secret_here
# Path ของ CA cert สำหรับ self-signed TLS (optional)
#HIKCENTRAL_CA_CERT_PATH=
#HIKCENTRAL_TLS_SKIP_HOSTNAME=true
# รหัสชนิด event (จำนวนเต็มคั่นด้วย ,) ที่ใช้นับในหน้า stats ของ NetGuard Manager ผ่าน GET /stats/detail
# ว่าง = ไม่ดึง event (eventRecords/page บังคับต้องระบุ eventTypes) — รหัสที่ถูกต้องดูจาก HikCentral OpenAPI Developer Guide
#HIKCENTRAL_EVENT_TYPES=131330,131331
# Circuit breaker ของ HikCentral: ล้มเหลวติดกัน N ครั้ง (timeout/เครือข่ายขาด/HTTP 5xx) → งดเรียกชั่วคราว แล้วลอง 1 คำขอหลัง cooldown
#HIKCENTRAL_BREAKER_THRESHOLD=3
#HIKCENTRAL_BREAKER_COOLDOWN_MS=60000
# timeout ต่อคำขอ HikCentral (มิลลิวินาที, ค่าเริ่มต้น 10000)
#HIKCENTRAL_TIMEOUT_MS=10000

# ── แจ้งเตือน LINE เมื่อมี Temperature Alarm จาก HikCentral (กล้องความร้อน) — ปิดเป็นค่าเริ่มต้น และเปิดมาก็เริ่มที่ DRYRUN ──
# ✔ ยืนยันกับ HikCentral จริง: eventType 192517 = Temperature Alarm; response ไม่มีตัวเลขอุณหภูมิ และ description ว่าง
#   → ข้อความแจ้งเตือนบอกกล้อง + เวลา (+07:00) แล้วให้ไปตรวจค่าอุณหภูมิที่ HikCentral
#HIKCENTRAL_TEMP_ALARM_ENABLED=false     # true = เปิดใช้ (ต้องตั้ง CAMERAS ด้วย ไม่งั้นไม่ทำงาน)
#HIKCENTRAL_TEMP_ALARM_DRYRUN=true       # true (ค่าเริ่มต้น) = log "ข้อความที่จะส่ง" อย่างเดียว ไม่ส่ง LINE ไม่เขียน state; ตั้ง false ชัดเจนเท่านั้นจึงส่งจริง
#HIKCENTRAL_TEMP_ALARM_TYPES=192517      # รหัส eventType (จำนวนเต็มคั่นด้วย ,)
#HIKCENTRAL_TEMP_ALARM_CAMERAS=1086,1087,1088,1089   # camera index code ที่เฝ้า (ต้องระบุตรงๆ ไม่เดาจากชื่อ)
#HIKCENTRAL_TEMP_ALARM_INTERVAL_SEC=60   # ตรวจทุกกี่วินาที (30–3600)
#HIKCENTRAL_TEMP_ALARM_LOOKBACK_MIN=30   # ค้นย้อนจาก watermark กี่นาที เผื่อ HikCentral บันทึกเหตุการณ์ช้า (1–1440; ค่าเริ่มต้น 30)
#HIKCENTRAL_TEMP_ALARM_COOLDOWN_MIN=10   # กล้องเดียวกันเกิดซ้ำภายในกี่นาที ไม่แจ้งซ้ำ แต่นับรวมในข้อความ (0 = ไม่ใช้)
#HIKCENTRAL_TEMP_ALARM_SEVERITY=3        # 3 = เฉพาะ ADMIN/IT_STAFF; 4 = ผู้ใช้ที่อนุมัติแล้วทุกระดับ

# ── แจ้งเตือน Omada traffic (AP) เกิน threshold — ปิดเป็นค่าเริ่มต้น (ไม่ตั้ง DOWN/UP = ไม่ทำงาน) ──
# ⚠️ หน่วย/ชื่อ field ของ traffic ใน Omada ยังไม่ยืนยันกับ controller จริง → เปิด DRYRUN ก่อน เทียบค่าใน log กับหน้า Omada
#OMADA_TRAFFIC_ALERT_DOWN_MBPS=200
#OMADA_TRAFFIC_ALERT_UP_MBPS=100
#OMADA_TRAFFIC_ALERT_SUSTAIN=2        # กี่ bucket (5 นาที) ติดกันถึงแจ้ง
#OMADA_TRAFFIC_ALERT_COOLDOWN_MIN=30  # ห่างระหว่างการแจ้งอย่างน้อยกี่นาที
#OMADA_TRAFFIC_ALERT_INTERVAL_MIN=5
#OMADA_TRAFFIC_ALERT_SEVERITY=3       # 3 = เฉพาะ ADMIN/IT_STAFF; 4+ ถึง VIEWER ด้วย
#OMADA_TRAFFIC_ALERT_DRYRUN=true      # คำนวณ/log อย่างเดียว ไม่ส่งข้อความ ไม่เขียน state

# ── AI Provider ────────────────────────────────────────────
# เลือกได้ 3 เจ้า: claude (default) / gemini / openai
# ตั้งเป็นเจ้าอื่นแต่ไม่มี API key ของเจ้านั้น → fallback กลับไป claude อัตโนมัติ
#AI_PROVIDER=claude

# Claude (Anthropic) — required เสมอ เพราะเป็น fallback บังคับของทุก provider
# API Key: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (Google AI) — optional ใส่เฉพาะเมื่อ AI_PROVIDER=gemini
# API Key: https://aistudio.google.com/apikey
#GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — optional ใส่เฉพาะเมื่อ AI_PROVIDER=openai
# API Key: https://platform.openai.com/api-keys
#OPENAI_API_KEY=your_openai_api_key_here

# ── Server ────────────────────────────────────────────────
# Port ที่ Bot จะรันใน process/container (Docker map เป็น 3100 ภายนอก)
PORT=3000

# ── Security ─────────────────────────────────────────────
# IP prefix ที่อนุญาตเข้า Setup UI เช่น 192.168.1. (เว้นว่างเพื่อรับทุก IP)
ALLOWED_IP_PREFIX=192.168.
# Secret สำหรับยืนยัน Zabbix Webhook — ใช้ค่าสุ่มยาวๆ เช่น openssl rand -hex 32
# ต้องตั้งค่า header  x-zabbix-secret  ฝั่ง Zabbix ให้ตรงกัน
ZABBIX_WEBHOOK_SECRET=your_random_webhook_secret_here

# ── Setup UI (optional) ───────────────────────────────────
# Password hash ของ Setup UI (SHA-256) — ตั้งได้ผ่าน Setup Wizard
# ถ้าไม่ตั้ง default password คือ "admin"
#SETUP_PASSWORD_HASH=

# ── AI Quota (optional) ──────────────────────────────────
# จำนวนครั้งที่แต่ละ user ใช้ AI ได้ต่อวัน (default: 20)
#AI_DAILY_QUOTA=20

# ── Cloudflare Tunnel (เฉพาะ tunnel แบบ token — ปัจจุบันใช้ config.yml + credentials file) ──
#CLOUDFLARE_TUNNEL_TOKEN=

# ── Ops: แจ้ง ADMIN เมื่อบอทล้ม (uncaughtException / unhandledRejection) ──────────
# ค่าเริ่มต้น: log อย่างเดียว ไม่ส่ง LINE — เปิดหลังทดสอบด้วย scripts/ops-crash-drill.js แล้วเท่านั้น
# เปิดการแจ้ง ADMIN ทาง LINE (เฉพาะ "true"); process ออกด้วย exit(1) ให้ Docker restart เสมอไม่ว่าตั้งค่านี้อย่างไร
#OPS_CRASH_NOTIFY=false
# แจ้งซ้ำได้อีกหลังกี่นาที (1–1440, ค่าเริ่มต้น 30) — บันทึกใน data/ops-alert.json จึงกันส่งรัวเมื่อ crash ซ้ำหลัง restart
#OPS_CRASH_NOTIFY_COOLDOWN_MIN=30
